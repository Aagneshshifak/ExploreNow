// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  name      String?
  email     String    @unique
  password  String
  role      String    @default("user")
  createdAt DateTime  @default(now())
  bookings  Booking[]

  @@map("users")
}

model Trip {
  id          String    @id @default(uuid())
  title       String
  location    String
  description String?
  price       Float
  duration    Int
  tags        String[]
  includes    String[]
  imageUrl    String?
  createdAt   DateTime  @default(now())
  bookings    Booking[]

  @@map("trips")
}

model Hotel {
  id          String    @id @default(uuid())
  name        String
  location    String
  description String?
  price       Float
  rating      Float
  tags        String[]
  includes    String[]
  amenities   String[]
  imageUrl    String?
  createdAt   DateTime  @default(now())
  bookings    Booking[]

  @@map("hotels")
}

model Booking {
  id        String    @id @default(uuid())
  userId    String
  tripId    String?
  hotelId   String?
  type      String // "trip" or "hotel"
  status    String    @default("pending")
  amount    Float
  checkIn   DateTime?
  checkOut  DateTime?
  createdAt DateTime  @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip  Trip?  @relation(fields: [tripId], references: [id], onDelete: SetNull)
  hotel Hotel? @relation(fields: [hotelId], references: [id], onDelete: SetNull)

  @@map("bookings")
}
