generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["nearby"]
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED

  @@schema("nearby")
}

model PrivacySettings {
  userId         String   @id // External ID from tourist-backend
  isDiscoverable Boolean  @default(true)
  searchRadius   Int      @default(500) // In meters
  updatedAt      DateTime @updatedAt

  @@schema("nearby")
}

model ConnectionRequest {
  id         String        @id @default(uuid())
  senderId   String        // External ID
  receiverId String        // External ID
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId])
  @@schema("nearby")
}

model MeetingHistory {
  id          String   @id @default(uuid())
  userAId     String   // External ID (always sort alphabetically before insert to avoid A->B vs B->A duplicates)
  userBId     String   // External ID
  latitude    Float?   // Optional: generalized coordinate for privacy
  longitude   Float?   // Optional: generalized coordinate for privacy
  meetingTime DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userAId])
  @@index([userBId])
  @@schema("nearby")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   // External ID
  action    String   // e.g., "PRIVACY_OPT_IN", "CONNECTION_ACCEPTED"
  ipAddress String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@schema("nearby")
}
